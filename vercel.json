{
  "rewrites": [
    {
      "source": "/gtmportal",
      "destination": "https://gtm-platform-beige.vercel.app/gtmportal"
    },
    {
      "source": "/gtmportal/",
      "destination": "https://gtm-platform-beige.vercel.app/gtmportal"
    },
    {
      "source": "/gtmportal/:path*",
      "destination": "https://gtm-platform-beige.vercel.app/gtmportal/:path*"
    }
  ],
  "functions": {
    "api/msaaed.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
